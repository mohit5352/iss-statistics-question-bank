# Copy to .env and fill in values (do not commit .env)
# For local server: python3 server.py 8000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secret-password
ADMIN_NAME=Admin
CONTACT_EMAIL=your.email@example.com

# Optional: Ollama HTTP API (default http://127.0.0.1:11434). Used by /api/ollama/chat proxy in server.py.
# Study chat UI loads only after admin login (see README).
# OLLAMA_HOST=http://127.0.0.1:11434
